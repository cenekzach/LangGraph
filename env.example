# OpenAI-compatible settings for local vLLM
OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local-dev
OPENAI_MODEL=meta-llama/Llama-3.1-8B-Instruct

# MCP filesystem server endpoint
MCP_FS_BASE_URL=http://127.0.0.1:8080/mcp
MCP_FS_READ_TOOL=read_file
MCP_FS_WRITE_TOOL=write_file
MCP_WORKSPACE_PREFIX=

# MCP python executor endpoint
MCP_PYTHON_BASE_URL=http://127.0.0.1:8090/mcp
MCP_PYTHON_RUN_SCRIPT_TOOL=python_run_script
MCP_PYTHON_SYNTAX_CHECK_TOOL=python_syntax_check
MCP_PYTHON_RUN_TESTS_TOOL=python_run_tests

# Workflow/runtime settings
MAX_REQUIREMENTS_ATTEMPTS=2
MAX_IMPLEMENTATION_ATTEMPTS=4
MAX_REVIEW_ATTEMPTS=2
LOG_LEVEL=INFO
